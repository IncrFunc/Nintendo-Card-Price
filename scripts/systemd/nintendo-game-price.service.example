[Unit]
Description=Nintendo Game Price daily automation
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/Nintendo_Game_Price
Environment=PYTHONUNBUFFERED=1
Environment=CONFIG=config.json
Environment=UI_HOST=127.0.0.1
Environment=UI_PORT=8765
Environment=XHS_PORT=9223
Environment=PUBLISH_DRIVER=adb
# Optional when more than one Android device is connected:
# Environment=ADB_DEVICE=2527b8b
# Optional when adb is not on PATH:
# Environment=ADB_PATH=/opt/android-sdk/platform-tools/adb
ExecStart=/opt/Nintendo_Game_Price/scripts/run_auto_linux.sh
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
