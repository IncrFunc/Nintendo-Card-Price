{
  "settings": {
    "timezone": "Asia/Shanghai",
    "daily_fetch_times": [
      "09:55",
      "15:55"
    ],
    "request": {
      "timeout_seconds": 10,
      "retries": 2,
      "retry_backoff_seconds": 1,
      "verify_ssl": false,
      "save_raw_response": false
    },
    "storage": {
      "prices_json": "data/prices.json",
      "csv_dir": "data/exports",
      "chart_dir": "data/charts",
      "reports_dir": "data/reports",
      "publish_dir": "data/publish",
      "runtime_dir": "data/runtime"
    },
    "games_file": "data/games.example.json",
    "default_xizi_uuid": "6c99e77fba4f44f9ac46b767fd079f0b"
  },
  "merchants": {
    "laolieren": {
      "name": "老猎人",
      "enabled": true,
      "parser": "laolieren",
      "endpoint": {
        "method": "POST",
        "url": "https://api.laolieren.com/v2/game/detail",
        "headers": {
          "content-type": "application/json"
        },
        "json": {
          "auth": "",
          "id": "{{game_id}}"
        }
      },
      "price_rules": {
        "calculation": "row.is_outside != 0 ? row.price + row.outside_diff : unavailable",
        "sell_price_path": "row.price",
        "outside_diff_path": "row.outside_diff",
        "availability_path": "row.is_outside"
      }
    },
    "huoqiangshou": {
      "name": "火枪手",
      "enabled": true,
      "parser": "huoqiangshou",
      "endpoint": {
        "method": "POST",
        "url": "https://api.huoqiangshou.cn/seller/sellerProduct/getProductDetail",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "data": {
          "productId": "{{game_id}}",
          "lottoProduct": false
        }
      },
      "apprize_endpoint": {
        "method": "POST",
        "url": "https://api.huoqiangshou.cn/seller/sellerProduct/getProductApprizeQuestion",
        "headers": {
          "content-type": "application/x-www-form-urlencoded"
        },
        "data": {
          "productId": "{{game_id}}"
        }
      },
      "price_rules": {
        "calculation": "detail.data.receivePrice - apprize.data.listProductQuestion[0].answers[1].reducePrice",
        "sell_price_paths": [
          "data.sellPrice",
          "data.salePrice",
          "data.price"
        ],
        "receive_price_path": "detail.data.receivePrice",
        "reduce_price_path": "apprize.data.listProductQuestion.0.answers.1.reducePrice"
      }
    },
    "hailuo": {
      "name": "海螺",
      "enabled": true,
      "parser": "hailuo",
      "requires_env": [
        "HAILUO_AUTHORIZATION"
      ],
      "endpoint": {
        "method": "GET",
        "url": "https://hailuo.dwzjd.com/api/product/detail/{{game_id}}",
        "headers": {
          "cb-lang": "zh-CN",
          "appid": "wx7f7b845076caaf81",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 MicroMessenger/7.0.20.1781(0x6700143B) NetType/WIFI MiniProgramEnv/Windows WindowsWechat/WMPF WindowsWechat(0x63090a13) UnifiedPCWindowsWechat(0xf2541939) XWEB/19841",
          "xweb_xhr": "1",
          "form-type": "routine",
          "content-type": "application/json",
          "accept": "*/*",
          "sec-fetch-site": "cross-site",
          "sec-fetch-mode": "cors",
          "sec-fetch-dest": "empty",
          "referer": "${HAILUO_REFERER}",
          "accept-encoding": "gzip, deflate, br",
          "accept-language": "zh-CN,zh;q=0.9",
          "priority": "u=1, i",
          "authori-zation": "${HAILUO_AUTHORIZATION}"
        }
      },
      "price_rules": {
        "calculation": "data.storeInfo.out_recycle != 0 ? data.storeInfo.price - data.storeInfo.out_diff : unavailable",
        "sell_price_path": "data.storeInfo.price",
        "out_diff_path": "data.storeInfo.out_diff",
        "availability_path": "data.storeInfo.out_recycle"
      }
    },
    "hangzhouxizi": {
      "name": "西子电玩",
      "enabled": true,
      "parser": "hangzhouxizi",
      "requires_env": [
        "XIZI_RECYCLEXCX"
      ],
      "endpoint": {
        "method": "POST",
        "url": "https://api.recycle.steamlease.cn/commodity/getCommodity",
        "headers": {
          "recyclexcx": "${XIZI_RECYCLEXCX}",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 MicroMessenger/7.0.20.1781(0x6700143B) NetType/WIFI MiniProgramEnv/Windows WindowsWechat/WMPF WindowsWechat(0x63090a13) UnifiedPCWindowsWechat(0xf2541939) XWEB/19841",
          "xweb_xhr": "1",
          "content-type": "application/json",
          "accept": "*/*",
          "sec-fetch-site": "cross-site",
          "sec-fetch-mode": "cors",
          "sec-fetch-dest": "empty",
          "referer": "${XIZI_REFERER}",
          "accept-encoding": "gzip, deflate, br",
          "accept-language": "zh-CN,zh;q=0.9",
          "priority": "u=1, i"
        },
        "json": {
          "id": "{{game_id}}",
          "uuid": "{{uuid}}"
        }
      },
      "price_rules": {
        "calculation": "first_available(recycle_price_paths) or sell_price - deduct_price",
        "sell_price_paths": [
          "data.sellPrice",
          "data.salePrice",
          "data.price",
          "data.commodityPrice"
        ],
        "recycle_price_paths": [
          "data.receivePrice",
          "data.recyclePrice",
          "data.recoveryPrice",
          "data.buybackPrice"
        ],
        "deduct_price_paths": [
          "data.deductPrice",
          "data.minusPrice",
          "data.offsetPrice"
        ],
        "notes": "字段结构需用真实响应确认；parser 已兼容常见 recycle/receive/buyback 字段。"
      }
    },
    "baibiandui": {
      "name": "百变兑",
      "enabled": true,
      "parser": "baibiandui",
      "requires_env": [
        "BAIBIANDUI_T"
      ],
      "endpoint": {
        "method": "GET",
        "url": "https://api.aemacross.com/goodsInfo/findById?id={{game_id}}",
        "headers": {
          "cb-lang": "zh-CN",
          "appid": "wx81ceaf48bed4bb56",
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 MicroMessenger/7.0.20.1781(0x6700143B) NetType/WIFI MiniProgramEnv/Windows WindowsWechat/WMPF WindowsWechat(0x63090a13) UnifiedPCWindowsWechat(0xf2541939) XWEB/19841",
          "xweb_xhr": "1",
          "form-type": "routine",
          "content-type": "application/json",
          "accept": "*/*",
          "sec-fetch-site": "cross-site",
          "sec-fetch-mode": "cors",
          "sec-fetch-dest": "empty",
          "referer": "https://servicewechat.com/wx81ceaf48bed4bb56/4/page-frame.html",
          "accept-encoding": "gzip, deflate, br",
          "accept-language": "zh-CN,zh;q=0.9",
          "priority": "u=1, i",
          "t": "${BAIBIANDUI_T}"
        }
      },
      "price_rules": {
        "calculation": "data.recycleSecondHandPrice; fallback data.recycleBareCardPrice",
        "sell_price_path": "data.replacementSecondHandPrice",
        "recycle_price_path": "data.recycleSecondHandPrice",
        "bare_card_recycle_price_path": "data.recycleBareCardPrice",
        "name_path": "data.title",
        "item_id_path": "data.id"
      }
    },
    "mogushijian": {
      "name": "蘑菇时间",
      "enabled": true,
      "parser": "mogushijian",
      "requires_env": [
        "MOGUSHIJIAN_TOKEN"
      ],
      "endpoint": {
        "method": "POST",
        "url": "https://api.mogushijian.com/alia/used/specInfo",
        "headers": {
          "user-agent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/132.0.0.0 Safari/537.36 MicroMessenger/7.0.20.1781(0x6700143B) NetType/WIFI MiniProgramEnv/Windows WindowsWechat/WMPF WindowsWechat(0x63090a13) UnifiedPCWindowsWechat(0xf2541a34) XWEB/19977",
          "xweb_xhr": "1",
          "content-type": "application/json",
          "alianame": "${MOGUSHIJIAN_ALIANAME:alia2}",
          "Token": "${MOGUSHIJIAN_TOKEN}",
          "accept": "*/*",
          "sec-fetch-site": "cross-site",
          "sec-fetch-mode": "cors",
          "sec-fetch-dest": "empty",
          "referer": "${MOGUSHIJIAN_REFERER:https://servicewechat.com/wx95e68e4fbf89d3f7/3/page-frame.html}",
          "accept-encoding": "gzip, deflate, br",
          "accept-language": "zh-CN,zh;q=0.9"
        },
        "json": {
          "cardsId": "{{game_id}}",
          "type": 2
        }
      },
      "price_rules": {
        "calculation": "specList[name=二手盒装].recyclePrice; fallback first spec recyclePrice",
        "sell_price_path": "specList[].buyPrice",
        "recycle_price_path": "specList[].recyclePrice",
        "name_path": "name",
        "item_id_path": "cardsId"
      }
    }
  }
}
